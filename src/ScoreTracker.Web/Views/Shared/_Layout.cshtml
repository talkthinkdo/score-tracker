<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 2026 World Cup Tracker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background-color: #0a1628; color: #e8f4f8; }
        .navbar { background: linear-gradient(135deg, #1a3a5c 0%, #0d2340 100%); border-bottom: 2px solid #c9a227; }
        .navbar-brand { color: #c9a227 !important; font-weight: 700; font-size: 1.4rem; }
        .nav-link { color: #b0c4d8 !important; }
        .card { background-color: #112038; border: 1px solid #1e3a5f; }
        .card-header { background: linear-gradient(90deg, #1e3a5f 0%, #152d4d 100%); border-bottom: 1px solid #c9a227; }
        .group-badge { background-color: #c9a227; color: #0a1628; font-weight: 700; padding: 2px 8px; border-radius: 4px; }
        .standings-table th { color: #c9a227; border-color: #1e3a5f; font-size: 0.85rem; }
        .standings-table td { border-color: #1e3a5f; font-size: 0.9rem; }
        .standings-table tr:nth-child(-n+2) td { background-color: rgba(201, 162, 39, 0.08); }
        .match-card { border-left: 3px solid #c9a227; margin-bottom: 0.75rem; background-color: #152d4d; border-radius: 6px; padding: 0.6rem 1rem; }
        .score-badge { font-size: 1.1rem; font-weight: 700; background: #c9a227; color: #0a1628; border-radius: 4px; padding: 2px 10px; }
        .status-completed { color: #5cb85c; font-size: 0.8rem; }
        .status-scheduled { color: #8bb4cc; font-size: 0.8rem; }
        .goal-entry { font-size: 0.9rem; color: #a0c4db; }
        .goal-minute { background: #1e3a5f; border-radius: 3px; padding: 1px 5px; font-size: 0.8rem; margin-right: 4px; }
        a { color: #7db3d0; }
        a:hover { color: #c9a227; }
        .btn-primary { background-color: #c9a227; border-color: #c9a227; color: #0a1628; }
        .btn-primary:hover { background-color: #b08c1f; border-color: #b08c1f; color: #0a1628; }
        .btn-outline-secondary { color: #8bb4cc; border-color: #1e3a5f; }
        .form-control, .form-select { background-color: #0d2340; border-color: #1e3a5f; color: #e8f4f8; }
        .form-control:focus, .form-select:focus { background-color: #0d2340; border-color: #c9a227; color: #e8f4f8; box-shadow: 0 0 0 0.2rem rgba(201,162,39,.25); }
        .table-dark { --bs-table-bg: #112038; --bs-table-striped-bg: #152d4d; --bs-table-border-color: #1e3a5f; }
        footer { border-top: 1px solid #1e3a5f; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    &#9917; 2026 World Cup
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Groups</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>
    <footer class="py-3 mt-4">
        <div class="container text-center">
            <small class="text-muted">2026 FIFA World Cup Tracker &mdash; Canada, Mexico, USA</small>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
