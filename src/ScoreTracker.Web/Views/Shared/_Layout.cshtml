<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 2026 World Cup Tracker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background-color: #0d1520; color: #e8edf2; }
        .navbar { background: #0d1520; border-bottom: 2px solid #e8b84b; }
        .navbar-brand { color: #e8b84b !important; font-weight: 700; font-size: 1.4rem; }
        .nav-link { color: #94a3b8 !important; }
        .card { background-color: #162233; border: 1px solid #243650; }
        .card-header { background: #1a2b40; border-bottom: 1px solid #243650; }
        .group-badge { background-color: #e8b84b; color: #0d1520; font-weight: 700; padding: 2px 8px; border-radius: 4px; }
        .standings-table th { color: #64748b; border-color: #243650; font-size: 0.85rem; }
        .standings-table td { border-color: #243650; font-size: 0.9rem; }
        .standings-table tr:nth-child(-n+2) td { background-color: rgba(34, 197, 94, 0.07); }
        .match-card { border-left: 3px solid #e8b84b; margin-bottom: 0.75rem; background-color: #1a2b40; border-radius: 6px; padding: 0.6rem 1rem; }
        .score-badge { font-size: 1.1rem; font-weight: 700; background: #e8b84b; color: #0d1520; border-radius: 4px; padding: 2px 10px; }
        .status-completed { color: #4ade80; font-size: 0.8rem; }
        .status-scheduled { color: #64748b; font-size: 0.8rem; }
        .goal-entry { font-size: 0.9rem; color: #94a3b8; }
        .goal-minute { background: #243650; border-radius: 3px; padding: 1px 5px; font-size: 0.8rem; margin-right: 4px; }
        a { color: #60a5fa; }
        a:hover { color: #e8b84b; }
        .btn-primary { background-color: #e8b84b; border-color: #e8b84b; color: #0d1520; }
        .btn-primary:hover { background-color: #d4a03a; border-color: #d4a03a; color: #0d1520; }
        .btn-outline-secondary { color: #94a3b8; border-color: #243650; }
        .form-control, .form-select { background-color: #0d1520; border-color: #243650; color: #e8edf2; }
        .form-control:focus, .form-select:focus { background-color: #0d1520; border-color: #e8b84b; color: #e8edf2; box-shadow: 0 0 0 0.2rem rgba(232,184,75,.25); }
        .table-dark { --bs-table-bg: #162233; --bs-table-striped-bg: #1a2b40; --bs-table-border-color: #243650; }
        footer { border-top: 1px solid #243650; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    &#9917; 2026 World Cup
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Groups</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>
    <footer class="py-3 mt-4">
        <div class="container text-center">
            <small class="text-muted">2026 FIFA World Cup Tracker &mdash; Canada, Mexico, USA</small>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
